# ============================================================
# FootHoled H1 - Waveshare ESP32-S3-Touch-LCD-3.5 (NON-B)
# ============================================================

# Target hardware
CONFIG_IDF_TARGET="esp32s3"

# Flash - 16 MB
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# Custom partition layout
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB Octal PSRAM at 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Existing FootHoled memory configuration
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Main task stack
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable the new I2C master driver (used by board_adapter.cpp for touch)
CONFIG_I2C_ENABLE_DEBUG_LOG=n

# SPI: allow large DMA transfers for the 320x480 frame buffer
CONFIG_SPI_MASTER_IN_IRAM=y